<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="uk.co.howardtv" android:versionCode="1" android:versionName="1.0-test1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="31" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/howardtv_badge"
        android:banner="@drawable/howardtv_banner" android:theme="@style/Home"
        android:hardwareAccelerated="true" android:largeHeap="false">
        <activity android:name=".HomeActivity" android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:excludeFromRecents="true" android:screenOrientation="landscape"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density|fontScale">
            <intent-filter android:priority="2">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also appears as a normal app in Shield's launcher before choosing it as Home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Its own task (empty affinity), so opening it over HDMI does not bring home forward. -->
        <activity android:name=".QuickSettingsActivity" android:exported="false" android:theme="@style/QuickSettings"
            android:taskAffinity="" android:launchMode="singleTask" android:excludeFromRecents="true"
            android:noHistory="true" android:label="@string/quick_settings" />
    </application>
</manifest>
