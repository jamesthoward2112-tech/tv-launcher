<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted without blur: a faint fill that is brighter at the top, and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
