<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#FFEDEDF0" android:textSize="15sp" android:singleLine="true" />
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFB4B4BA" android:textSize="15sp" android:singleLine="true" />
</LinearLayout>
